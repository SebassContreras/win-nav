{
  "name": "win-nav",
  "version": "0.1.0",
  "description": "Stable CLI + MCP bridge for QA testing and lawful assisted desktop automation on native Windows applications (WinForms, WPF, Velopack) via UI Automation",
  "type": "module",
  "bin": {
    "win-nav": "./dist/cli.js",
    "win-nav-mcp": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "windows",
    "winforms",
    "wpf",
    "velopack",
    "ui-automation",
    "flaui",
    "mcp",
    "agentic-ai",
    "qa-testing"
  ],
  "author": "Sebastian Contreras",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
